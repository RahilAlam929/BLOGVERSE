import Link from "next/link";
import { createClient } from "@/lib/supabase/server";

type Post = {
  id: number;
  slug: string;
  title: string;
  excerpt?: string | null;
  cover_image?: string | null;
  category?: string | null;
  topic?: string | null;
  language?: string | null;
  guest_name?: string | null;
  guest_id?: string | null;
  created_at?: string | null;
  likes?: { id: number }[] | null;
};

function formatDate(date?: string | null) {
  if (!date) return "Recently";

  const parsed = new Date(date);

  if (Number.isNaN(parsed.getTime())) {
    return "Recently";
  }

  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(parsed);
}

function truncate(text?: string | null, length = 150) {
  if (!text) {
    return "Discover a fresh perspective from the BlogVerse community.";
  }

  const clean = text.replace(/\s+/g, " ").trim();

  return clean.length > length
    ? `${clean.slice(0, length)}...`
    : clean;
}

function getCategory(post: Post) {
  return post.topic || post.category || "Article";
}

function getAuthor(post: Post) {
  return post.guest_name || "Anonymous writer";
}

function Cover({
  post,
  featured = false,
}: {
  post: Post;
  featured?: boolean;
}) {
  return (
    <div
      className={`relative overflow-hidden ${
        featured ? "aspect-[16/10]" : "aspect-[16/10]"
      } bg-[var(--surface-muted)]`}
    >
      {post.cover_image ? (
        // eslint-disable-next-line @next/next/no-img-element
        <img
          src={post.cover_image}
          alt={post.title}
          className="h-full w-full object-cover transition duration-700 group-hover:scale-105"
        />
      ) : (
        <div className="relative flex h-full items-center justify-center overflow-hidden bg-[var(--surface-muted)]">
          <div className="absolute -left-20 -top-20 h-56 w-56 rounded-full bg-violet-500/10 blur-3xl" />
          <div className="absolute -bottom-20 -right-20 h-56 w-56 rounded-full bg-blue-500/10 blur-3xl" />

          <span className="relative text-6xl font-black tracking-[-0.08em] text-[var(--reading-text)]/10">
            BV
          </span>
        </div>
      )}

      <div className="absolute inset-0 bg-gradient-to-t from-black/65 via-black/5 to-transparent opacity-80" />

      {featured && (
        <div className="absolute left-5 top-5 rounded-full border border-white/15 bg-black/45 px-3 py-1.5 text-[10px] font-black uppercase tracking-[0.2em] text-white backdrop-blur-xl">
          Featured
        </div>
      )}
    </div>
  );
}

export default async function HomePage() {
  const supabase = await createClient();

  const { data: rawPosts, error } = await supabase
    .from("posts")
    .select(`
      id,
      slug,
      title,
      excerpt,
      cover_image,
      category,
      topic,
      language,
      guest_name,
      guest_id,
      created_at,
      likes(id)
    `)
    .order("created_at", { ascending: false });

  if (error) {
    console.error(
      "BlogVerse homepage error:",
      JSON.stringify(error, null, 2)
    );
  }

  const posts = (rawPosts ?? []) as Post[];

  const publishedBlogs = posts.length;

  const writers = new Set(
    posts
      .map((post) => post.guest_id || post.guest_name)
      .filter(Boolean)
  ).size;

  const totalLikes = posts.reduce(
    (total, post) => total + (post.likes?.length ?? 0),
    0
  );

  const featured = posts[0];
  const latestPosts = posts.slice(1, 7);

  return (
    <main className="min-h-screen overflow-x-hidden bg-[var(--reading-bg)] text-[var(--reading-text)]">
      {/* BACKGROUND */}

      <div className="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
        <div className="absolute -left-40 top-24 h-[520px] w-[520px] rounded-full bg-violet-500/[0.08] blur-[140px]" />
        <div className="absolute -right-40 top-[35%] h-[520px] w-[520px] rounded-full bg-blue-500/[0.07] blur-[140px]" />
        <div className="absolute bottom-[-220px] left-[35%] h-[500px] w-[500px] rounded-full bg-fuchsia-500/[0.05] blur-[140px]" />
      </div>

      {/* HERO */}

      <section className="relative border-b border-[var(--reading-border)]">
        <div className="mx-auto max-w-7xl px-5 pb-16 pt-12 sm:px-8 sm:pb-20 sm:pt-16 lg:px-10 lg:pb-24 lg:pt-20">
          <div className="grid items-center gap-12 lg:grid-cols-[1fr_0.95fr] lg:gap-16">
            <div>
              <div className="mb-6 inline-flex items-center gap-2 rounded-full border border-[var(--reading-border)] bg-[var(--reading-surface)] px-4 py-2 text-[10px] font-black uppercase tracking-[0.2em] text-[var(--reading-muted)] shadow-sm backdrop-blur-xl">
                <span className="h-1.5 w-1.5 rounded-full bg-emerald-500" />
                The modern writing community
              </div>

              <h1 className="max-w-4xl text-5xl font-black leading-[0.94] tracking-[-0.065em] sm:text-6xl lg:text-7xl">
                Ideas deserve
                <br />
                <span className="bg-gradient-to-r from-[var(--reading-text)] via-[var(--reading-text)] to-[var(--reading-muted)] bg-clip-text text-transparent">
                  a place to live.
                </span>
              </h1>

              <p className="mt-7 max-w-2xl text-base leading-7 text-[var(--reading-muted)] sm:text-lg sm:leading-8">
                Read thoughtful stories, discover useful ideas and
                publish your own perspective with the BlogVerse community.
              </p>

              <div className="mt-9 flex flex-col gap-3 sm:flex-row">
                <Link
                  href="/blogs"
                  className="group inline-flex items-center justify-center rounded-2xl bg-[var(--reading-text)] px-6 py-3.5 text-sm font-black text-[var(--reading-bg)] shadow-lg transition duration-300 hover:-translate-y-0.5 hover:shadow-xl"
                >
                  Explore stories
                  <span className="ml-2 transition-transform group-hover:translate-x-1">
                    →
                  </span>
                </Link>

                <Link
                  href="/create"
                  className="inline-flex items-center justify-center rounded-2xl border border-[var(--reading-border)] bg-[var(--reading-surface)] px-6 py-3.5 text-sm font-bold text-[var(--reading-text)] shadow-sm transition duration-300 hover:-translate-y-0.5 hover:shadow-md"
                >
                  Start writing
                </Link>
              </div>

              <div className="mt-12 grid max-w-xl grid-cols-3 border-y border-[var(--reading-border)] py-6">
                <div>
                  <p className="text-2xl font-black tracking-tight">
                    {publishedBlogs}
                  </p>
                  <p className="mt-1 text-[10px] font-black uppercase tracking-[0.16em] text-[var(--reading-muted)]">
                    Stories
                  </p>
                </div>

                <div className="border-l border-[var(--reading-border)] pl-5">
                  <p className="text-2xl font-black tracking-tight">
                    {writers}
                  </p>
                  <p className="mt-1 text-[10px] font-black uppercase tracking-[0.16em] text-[var(--reading-muted)]">
                    Writers
                  </p>
                </div>

                <div className="border-l border-[var(--reading-border)] pl-5">
                  <p className="text-2xl font-black tracking-tight">
                    {totalLikes}
                  </p>
                  <p className="mt-1 text-[10px] font-black uppercase tracking-[0.16em] text-[var(--reading-muted)]">
                    Likes
                  </p>
                </div>
              </div>
            </div>

            {/* FEATURED */}

            <div className="relative lg:pt-4">
              {featured ? (
                <Link
                  href={`/blog/${featured.slug}`}
                  className="group block overflow-hidden rounded-[30px] border border-[var(--reading-border)] bg-[var(--reading-surface)] shadow-xl transition duration-500 hover:-translate-y-1 hover:shadow-2xl"
                >
                  <Cover post={featured} featured />

                  <div className="p-6 sm:p-7">
                    <div className="flex flex-wrap items-center gap-2 text-xs font-bold">
                      <span className="text-violet-500">
                        {getCategory(featured)}
                      </span>

                      <span className="text-[var(--reading-muted)]">
                        •
                      </span>

                      <span className="text-[var(--reading-muted)]">
                        {formatDate(featured.created_at)}
                      </span>
                    </div>

                    <h2 className="mt-3 text-2xl font-black leading-tight tracking-[-0.035em] sm:text-3xl">
                      {featured.title}
                    </h2>

                    <p className="mt-3 line-clamp-3 text-sm leading-6 text-[var(--reading-muted)]">
                      {truncate(featured.excerpt, 180)}
                    </p>

                    <div className="mt-6 flex items-center justify-between border-t border-[var(--reading-border)] pt-5">
                      <span className="max-w-[55%] truncate text-sm font-bold text-[var(--reading-muted)]">
                        {getAuthor(featured)}
                      </span>

                      <span className="text-sm font-black transition group-hover:translate-x-1">
                        Read story →
                      </span>
                    </div>
                  </div>
                </Link>
              ) : (
                <div className="rounded-[30px] border border-[var(--reading-border)] bg-[var(--reading-surface)] p-10 text-center shadow-xl">
                  <div className="mx-auto flex h-20 w-20 items-center justify-center rounded-3xl bg-[var(--reading-muted)]/10 text-2xl font-black">
                    BV
                  </div>

                  <h2 className="mt-6 text-2xl font-black">
                    Your first story starts here.
                  </h2>

                  <p className="mx-auto mt-3 max-w-sm text-sm leading-6 text-[var(--reading-muted)]">
                    Publish an article and it will appear on the BlogVerse
                    homepage.
                  </p>

                  <Link
                    href="/create"
                    className="mt-6 inline-flex rounded-2xl bg-[var(--reading-text)] px-5 py-3 text-sm font-black text-[var(--reading-bg)]"
                  >
                    Create article →
                  </Link>
                </div>
              )}
            </div>
          </div>
        </div>
      </section>

      {/* LATEST */}

      <section className="mx-auto max-w-7xl px-5 py-16 sm:px-8 lg:px-10 lg:py-20">
        <div className="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
          <div>
            <p className="text-[11px] font-black uppercase tracking-[0.22em] text-violet-500">
              Latest stories
            </p>

            <h2 className="mt-2 text-3xl font-black tracking-[-0.045em] sm:text-4xl">
              Fresh from BlogVerse
            </h2>

            <p className="mt-3 max-w-xl text-sm leading-6 text-[var(--reading-muted)]">
              New perspectives, technical discoveries and stories from
              writers building and learning every day.
            </p>
          </div>

          <Link
            href="/blogs"
            className="text-sm font-black text-[var(--reading-muted)] transition hover:text-[var(--reading-text)]"
          >
            View all →
          </Link>
        </div>

        {latestPosts.length > 0 ? (
          <div className="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {latestPosts.map((post) => (
              <Link
                key={post.id}
                href={`/blog/${post.slug}`}
                className="group overflow-hidden rounded-[26px] border border-[var(--reading-border)] bg-[var(--reading-surface)] shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl"
              >
                <Cover post={post} />

                <div className="p-5">
                  <div className="flex flex-wrap items-center gap-2 text-[10px] font-black uppercase tracking-wider text-[var(--reading-muted)]">
                    <span className="rounded-full border border-[var(--reading-border)] bg-[var(--reading-surface)] px-2.5 py-1 text-violet-500">
                      {getCategory(post)}
                    </span>

                    {post.language ? <span>{post.language}</span> : null}

                    <span>•</span>

                    <span>{formatDate(post.created_at)}</span>
                  </div>

                  <h3 className="mt-4 line-clamp-2 text-xl font-black leading-tight tracking-[-0.025em]">
                    {post.title}
                  </h3>

                  <p className="mt-3 line-clamp-3 text-sm leading-6 text-[var(--reading-muted)]">
                    {truncate(post.excerpt)}
                  </p>

                  <div className="mt-5 flex items-center justify-between border-t border-[var(--reading-border)] pt-4">
                    <span className="max-w-[65%] truncate text-xs font-bold text-[var(--reading-muted)]">
                      {getAuthor(post)}
                    </span>

                    <span className="text-xs font-black transition group-hover:translate-x-1">
                      Read →
                    </span>
                  </div>
                </div>
              </Link>
            ))}
          </div>
        ) : (
          <div className="mt-10 rounded-[28px] border border-[var(--reading-border)] bg-[var(--reading-surface)] p-10 text-center">
            <h3 className="text-xl font-black">No more stories yet</h3>

            <p className="mt-2 text-sm text-[var(--reading-muted)]">
              Be one of the first writers on BlogVerse.
            </p>

            <Link
              href="/create"
              className="mt-5 inline-flex rounded-2xl bg-[var(--reading-text)] px-5 py-3 text-sm font-black text-[var(--reading-bg)]"
            >
              Write your first story →
            </Link>
          </div>
        )}
      </section>

      {/* FEATURES */}

      <section className="mx-auto max-w-7xl px-5 pb-16 sm:px-8 lg:px-10 lg:pb-20">
        <div className="mb-8">
          <p className="text-[11px] font-black uppercase tracking-[0.22em] text-violet-500">
            Why BlogVerse
          </p>

          <h2 className="mt-2 text-3xl font-black tracking-[-0.045em]">
            Built for ideas, not noise.
          </h2>
        </div>

        <div className="grid gap-4 md:grid-cols-3">
          {[
            {
              icon: "✦",
              title: "Discover",
              text: "Find interesting ideas and useful perspectives without endless noise.",
            },
            {
              icon: "✎",
              title: "Create",
              text: "Turn your knowledge, experiences and ideas into beautiful stories.",
            },
            {
              icon: "↗",
              title: "Connect",
              text: "Follow writers, engage with stories and become part of the community.",
            },
          ].map((item) => (
            <div
              key={item.title}
              className="group rounded-[26px] border border-[var(--reading-border)] bg-[var(--reading-surface)] p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl"
            >
              <div className="flex h-11 w-11 items-center justify-center rounded-2xl bg-violet-500/10 text-lg text-violet-500 transition group-hover:scale-105">
                {item.icon}
              </div>

              <h3 className="mt-5 text-lg font-black">{item.title}</h3>

              <p className="mt-2 text-sm leading-6 text-[var(--reading-muted)]">
                {item.text}
              </p>
            </div>
          ))}
        </div>
      </section>

      {/* CTA */}

      <section className="mx-auto max-w-7xl px-5 pb-16 sm:px-8 lg:px-10 lg:pb-24">
        <div className="relative overflow-hidden rounded-[32px] border border-[var(--reading-border)] bg-[var(--reading-surface)] px-6 py-12 shadow-xl sm:px-10 lg:px-14 lg:py-16">
          <div className="pointer-events-none absolute -right-24 -top-32 h-80 w-80 rounded-full bg-violet-500/10 blur-[100px]" />
          <div className="pointer-events-none absolute -bottom-40 left-1/3 h-80 w-80 rounded-full bg-blue-500/10 blur-[100px]" />

          <div className="relative flex flex-col justify-between gap-8 lg:flex-row lg:items-center">
            <div className="max-w-2xl">
              <p className="text-[10px] font-black uppercase tracking-[0.22em] text-violet-500">
                Start your next chapter
              </p>

              <h2 className="mt-3 text-3xl font-black tracking-[-0.045em] sm:text-4xl">
                Have something worth saying?
              </h2>

              <p className="mt-3 text-sm leading-6 text-[var(--reading-muted)] sm:text-base">
                Write it. Publish it. Let the right people discover it.
              </p>
            </div>

            <div className="flex shrink-0 flex-col gap-3 sm:flex-row">
              <Link
                href="/create"
                className="rounded-2xl bg-[var(--reading-text)] px-6 py-3.5 text-center text-sm font-black text-[var(--reading-bg)] transition hover:-translate-y-0.5"
              >
                Start writing →
              </Link>

              <Link
                href="/blogs"
                className="rounded-2xl border border-[var(--reading-border)] px-6 py-3.5 text-center text-sm font-bold text-[var(--reading-text)] transition hover:bg-[var(--reading-muted)]/10"
              >
                Browse stories
              </Link>
            </div>
          </div>
        </div>
      </section>
    </main>
  );
}
